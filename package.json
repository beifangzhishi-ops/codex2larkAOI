{
  "name": "codex-feishu-cli-bridge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Bridge Feishu CLI message events to Codex CLI sessions.",
  "scripts": {
    "start": "node src/service-control.js launch",
    "start:foreground": "node src/service-control.js start",
