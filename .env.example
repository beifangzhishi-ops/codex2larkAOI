# Codex operates in this directory. Use an absolute path.
CODEX_WORKDIR=C:\Users\noha\Documents\AAAVitalFile

# Development: initialize a separate test bot in this isolated lark-cli directory.
LARKSUITE_CLI_CONFIG_DIR=C:\Users\noha\.lark-cli-codex2lark-dev

# Required: comma-separated Feishu sender open_ids (ou_xxx). No wildcard is accepted.
FEISHU_ALLOWED_OPEN_IDS=ou_replace_me

# Group messages are ignored unless explicitly enabled.
FEISHU_ALLOW_GROUPS=false

# Add Typing while a Codex turn runs, remove it on success, and use CrossMark on failure.
FEISHU_REACTIONS=true

# Optional Codex model override. Empty means use the Codex config default.
CODEX_MODEL=

# auto: Codex runs without approval prompts. manual: approve in Feishu with /approve or /deny.
CODEX_APPROVAL_MODE=auto

# One Codex turn may run for up to this many milliseconds.
CODEX_TIMEOUT_MS=1800000

# Reply chunk size and persisted event deduplication window.
FEISHU_REPLY_CHARS=3500
EVENT_CACHE_SIZE=1000
