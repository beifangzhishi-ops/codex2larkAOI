# Codex 默认在此目录工作，请使用绝对路径。
CODEX_WORKDIR=C:\Users\noha\Documents\AAAVitalFile

# AOI 开发槽使用独立的 lark-cli 配置目录和测试机器人。
LARKSUITE_CLI_CONFIG_DIR=C:\Users\noha\.lark-cli-codex2lark-dev

# 必填：允许访问的飞书用户 open_id，多个值用逗号分隔；不接受通配符。
# 这些用户也会获得机器人根目录 codex 文件夹的编辑权限。
FEISHU_ALLOWED_OPEN_IDS=ou_replace_me

# 默认忽略群聊消息。
FEISHU_ALLOW_GROUPS=false

# Codex 执行时显示 Typing，成功后移除，失败时改为 CrossMark。
FEISHU_REACTIONS=true

# 可选的业务模型覆盖；留空时使用 Codex 默认模型。
CODEX_MODEL=

# 仅用于异步会话标题的独立模型和思考强度，不跟随聊天级 /model 设置。
CODEX_TITLE_MODEL=gpt-5.6-luna
CODEX_TITLE_EFFORT=low

# 可选的 codex.exe 绝对路径；留空时自动查找 Codex CLI 或 VS Code 扩展。
CODEX_COMMAND=

# auto：使用 App Server Auto-review；manual：使用飞书审批卡片及文字命令回退。
CODEX_APPROVAL_MODE=auto

# guide：将运行中的会话消息引导到当前任务；queue：等待当前任务结束后顺序执行。
CODEX_INTERJECTION_MODE=guide

# 单个 Codex turn 的最长运行时间，单位为毫秒。
CODEX_TIMEOUT_MS=1800000

# 飞书回复分段字符数和持久化事件去重窗口。
FEISHU_REPLY_CHARS=3500
EVENT_CACHE_SIZE=1000
